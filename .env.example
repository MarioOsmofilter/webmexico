# Base de datos PostgreSQL
DATABASE_URL="postgresql://usuario:password@localhost:5432/water_crm?schema=public"

# NextAuth (Autenticación)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="genera-esto-con-openssl-rand-base64-32"

# Configuración multi-empresa
NEXT_PUBLIC_MAIN_DOMAIN="water-crm.com"
NEXT_PUBLIC_USE_SUBDOMAINS="true"  # true o false

# APIs externas (opcional)
GOOGLE_MAPS_API_KEY=""
MAPBOX_ACCESS_TOKEN=""

# Email (opcional, para notificaciones)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@water-crm.com"

# Almacenamiento de archivos (opcional)
# Usar AWS S3, Cloudinary, etc
STORAGE_PROVIDER="local"  # local, s3, cloudinary
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="eu-west-1"
AWS_BUCKET=""

# Cloudinary (alternativa)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# OpenAI (para rutas optimizadas con IA - opcional)
OPENAI_API_KEY=""

# Modo de desarrollo
NODE_ENV="development"

# Logs
LOG_LEVEL="info"  # debug, info, warn, error
